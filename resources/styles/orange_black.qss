QMainWindow, QWidget {
    background-color: #0a0a0a;
    color: #ffba66;
    font-family: "Segoe UI", sans-serif;
    font-size: 10pt;
}
QMenuBar, QToolBar, QStatusBar {
    background: #111111;
    border-color: #ff7b00;
}
QMenuBar::item:selected, QMenu::item:selected {
    background: #2a1a0a;
    color: #ffa94d;
}
QTabWidget::pane {
    background: #121212;
    border: 1px solid #3d2200;
}
QTabBar::tab {
    background: #1a1a1a;
    color: #c78a4a;
    padding: 8px 12px;
}
QTabBar::tab:selected {
    background: #2b1a08;
    color: #ff9b30;
}
QLineEdit, QTextEdit, QComboBox, QSpinBox {
    background: #151515;
    border: 1px solid #4a2a05;
    color: #ffd4a3;
    border-radius: 6px;
    padding: 6px;
}
QPushButton, QToolButton {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #d96a00, stop:1 #ff8f1f);
    color: #111111;
    border: none;
    border-radius: 7px;
    padding: 7px 11px;
    font-weight: 700;
}
QPushButton:hover, QToolButton:hover {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #ff7f11, stop:1 #ff9f3f);
}
QTableView, QListView {
    background: #121212;
    alternate-background-color: #181818;
    border: 1px solid #3d2200;
    gridline-color: #2f1b03;
}
QHeaderView::section {
    background: #221507;
    color: #ff9d3f;
    border-right: 1px solid #3d2200;
    padding: 7px;
}
